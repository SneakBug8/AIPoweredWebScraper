<%- include('../partials/head') %>

<h1>McKinsey Insights Scraper</h1>
<p>Scrape mckinsey.com and extract numerical reference data facts with the LLM. Stats refresh on each page load.</p>

<% function formatNum(v) {
    if (v === undefined || v === null) return "-";
    return Number(v).toLocaleString("en-US");
} %>

<% if (locals.message) { %>
    <div class="alert alert-success">
        <%= message %>
    </div>
<% } %>

<% if (locals.error) { %>
    <div class="alert alert-danger">
        <%= error %>
    </div>
<% } %>

<div class="row">
    <div class="col-md-4">
        <div class="card mb-3">
            <div class="card-header">Actions</div>
            <div class="card-body">
                <form method="POST" action="/knowledge/mckinsey/scrape">
                    <button type="submit" class="btn btn-primary w-100 mb-2">Run McKinsey scraping</button>
                </form>
                <form method="POST" action="/knowledge/mckinsey/convert">
                    <button type="submit" class="btn btn-secondary w-100 mb-2">Convert all to Markdown</button>
                </form>
                <form method="POST" action="/knowledge/mckinsey/extract">
                    <button type="submit" class="btn btn-success w-100">Extract all facts</button>
                </form>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card mb-3">
            <div class="card-header">System status</div>
            <div class="card-body">
                <table class="table table-sm">
                    <tbody>
                        <tr>
                            <td>Telegram bot</td>
                            <td>
                                <% if (system.botAvailable) { %>
                                    <span class="text-success">Available</span>
                                <% } else { %>
                                    <span class="text-danger">Not available</span>
                                <% } %>
                            </td>
                        </tr>
                        <tr>
                            <td>McKinsey scraping</td>
                            <td>
                                <% if (system.sourceBusy) { %>
                                    <span class="text-warning">In progress</span>
                                <% } else { %>
                                    <span class="text-success">Idle</span>
                                <% } %>
                            </td>
                        </tr>
                        <tr>
                            <td>Fact extraction</td>
                            <td>
                                <% if (system.extractionBusy) { %>
                                    <span class="text-warning">In progress</span>
                                <% } else { %>
                                    <span class="text-success">Idle</span>
                                <% } %>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card mb-3">
            <div class="card-header">Database stats</div>
            <div class="card-body">
                <table class="table table-sm">
                    <tbody>
                        <tr>
                            <td>Industry facts</td>
                            <td><%= formatNum(db.facts) %></td>
                        </tr>
                        <tr>
                            <td>Scraped pages</td>
                            <td><%= formatNum(db.scrapedPages) %></td>
                        </tr>
                        <tr>
                            <td>Scraping queue</td>
                            <td><%= formatNum(db.scrapeQueue) %></td>
                        </tr>
                        <tr>
                            <td>Markdown queue</td>
                            <td><%= formatNum(db.mdQueue) %></td>
                        </tr>
                        <tr>
                            <td>Field extraction queue</td>
                            <td><%= formatNum(db.fieldQueue) %></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<h2>Latest facts</h2>
<table id="facts" class="display">
    <thead>
        <tr>
            <td>Id</td>
            <td>Topic</td>
            <td>Metric</td>
            <td>Value</td>
            <td>Region</td>
            <td>Qualifier</td>
            <td>Date</td>
            <td>Fact</td>
            <td>Source</td>
        </tr>
    </thead>
    <tbody>
        <% for (let fact of latestFacts) { %>
            <tr>
                <td><%= fact.Id %></td>
                <td><%= fact.topic %></td>
                <td><%= fact.metric %></td>
                <td><%= fact.value %></td>
                <td><%= fact.region %></td>
                <td><%= fact.qualifier %></td>
                <td><%= fact.date %></td>
                <td><%= fact.fact %></td>
                <td><a href="<%= fact.source %>" target="_blank"><%= fact.source %></a></td>
            </tr>
        <% } %>
    </tbody>
</table>

<script defer>
    $(document).ready(function () {
        $('#facts').DataTable({
            "order": [[ 0, "desc" ]]
        });
    });
</script>

<%- include('../partials/bottom') %>