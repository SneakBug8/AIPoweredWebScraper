<%- include('../partials/head') %>

<h1>Apartment Scraper</h1>
<p>Run the CIAN scraper and the LLM field extractor without Telegram. Stats refresh on each page load.</p>

<% function formatNum(v) {
    if (v === undefined || v === null) return "-";
    return Number(v).toLocaleString("en-US");
} %>

<% if (locals.message) { %>
    <div class="alert alert-success">
        <%= message %>
    </div>
<% } %>

<% if (locals.error) { %>
    <div class="alert alert-danger">
        <%= error %>
    </div>
<% } %>

<div class="row">
    <div class="col-md-4">
        <div class="card mb-3">
            <div class="card-header">Actions</div>
            <div class="card-body">
                <form method="POST" action="/apartments/scrape">
                    <button type="submit" class="btn btn-primary w-100 mb-2">Run CIAN scraping</button>
                </form>
                <form method="POST" action="/apartments/extract">
                    <button type="submit" class="btn btn-success w-100">Extract all fields</button>
                </form>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card mb-3">
            <div class="card-header">System status</div>
            <div class="card-body">
                <table class="table table-sm">
                    <tbody>
                        <tr>
                            <td>Telegram bot</td>
                            <td>
                                <% if (system.botAvailable) { %>
                                    <span class="text-success">Available</span>
                                <% } else { %>
                                    <span class="text-danger">Not available</span>
                                <% } %>
                            </td>
                        </tr>
                        <tr>
                            <td>CIAN scraping</td>
                            <td>
                                <% if (system.sourceBusy) { %>
                                    <span class="text-warning">In progress</span>
                                <% } else { %>
                                    <span class="text-success">Idle</span>
                                <% } %>
                            </td>
                        </tr>
                        <tr>
                            <td>Field extraction</td>
                            <td>
                                <% if (system.extractionBusy) { %>
                                    <span class="text-warning">In progress</span>
                                <% } else { %>
                                    <span class="text-success">Idle</span>
                                <% } %>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card mb-3">
            <div class="card-header">Database stats</div>
            <div class="card-body">
                <table class="table table-sm">
                    <tbody>
                        <tr>
                            <td>Apartment postings</td>
                            <td><%= formatNum(db.postings) %></td>
                        </tr>
                        <tr>
                            <td>Scraped pages</td>
                            <td><%= formatNum(db.scrapedPages) %></td>
                        </tr>
                        <tr>
                            <td>Scraping queue</td>
                            <td><%= formatNum(db.scrapeQueue) %></td>
                        </tr>
                        <tr>
                            <td>Markdown queue</td>
                            <td><%= formatNum(db.mdQueue) %></td>
                        </tr>
                        <tr>
                            <td>Field extraction queue</td>
                            <td><%= formatNum(db.fieldQueue) %></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<h2>Latest postings</h2>
<table id="postings" class="display">
    <thead>
        <tr>
            <td>Id</td>
            <td>Type</td>
            <td>Subway</td>
            <td>Area</td>
            <td>Year</td>
            <td>Price</td>
            <td>Price / m&sup2;</td>
            <td>Source</td>
        </tr>
    </thead>
    <tbody>
        <% for (let posting of latestPostings) { %>
            <tr>
                <td><%= posting.Id %></td>
                <td><%= posting.type %></td>
                <td><%= posting.subwayStation %></td>
                <td><%= posting.area %></td>
                <td><%= posting.year_of_construction %></td>
                <td><%= formatNum(posting.price) %></td>
                <td><%= formatNum(posting.price_per_meter) %></td>
                <td><%= posting.source %></td>
            </tr>
        <% } %>
    </tbody>
</table>

<script defer>
    $(document).ready(function () {
        $('#postings').DataTable({
            "order": [[ 0, "desc" ]]
        });
    });
</script>

<%- include('../partials/bottom') %>