<%- include('../partials/head') %>

    <h1>Price Report: Cheapest by Category</h1>
    <p>Displays the cheapest commodity in each category (based on Price/1000).</p>
    <style>
        .numbercol {
            text-align: right;
        }
    </style>
    <% function formatDate(v) { if (!v) { v=0; } var d=new Date(Number.parseInt(v, 10)); return d.getFullYear() + "-" +
        (d.getMonth() + 1) + "-" + d.getDate(); } %>
                        <table id="prices">
                            <thead>
                                <td>Category</td>
                                <td>Shop</td>
                                <td>Commodity</td>
                                <td>Price</td>
                                <td>Volume</td>
                                <td>Unit</td>
                                <td>Price/1000</td>
                                <td>Creation Date</td>
                            </thead>
                            <tbody id="tbody">
                                <% for (record of prices) { %>
                                    <tr>
                                        <td class="numbercol">
                                            <%= record.category || "" %>
                                        </td>
                                        <td class="numbercol">
                                            <%= record.shop || "" %>
                                        </td>
                                        <td class="numbercol">
                                            <%= record.commodity || "" %>
                                        </td>
                                        <td class="numbercol">
                                            <%= record.price || 0 %>
                                        </td>
                                        <td class="numbercol">
                                            <%= record.volume || 0 %>
                                        </td>
                                        <td class="numbercol">
                                            <%= record.unit || "" %>
                                        </td>
                                        <td class="numbercol">
                                            <%= record.pricePer1000 ? record.pricePer1000.toFixed(2) : 0 %>
                                        </td>
                                        <td class="numbercol">
                                            <%= formatDate(record.MIS_DT) || 0 %>
                                        </td>
                                    </tr>
                                    <% } %>
                            </tbody>
                        </table>
                        <div class="mt-3">
                            <a href="/prices" class="btn btn-primary">Back to Price Management</a>
                        </div>
                        <script defer>
                            $(document).ready(function () {
                                $('#prices').DataTable();
                            });

                        </script>

                        <%- include('../partials/bottom') %>
